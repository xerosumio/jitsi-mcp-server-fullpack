# Jitsi MCP Server Configuration

# Jitsi Meet server URL (default: meet.jit.si)
JITSI_SERVER_URL=https://meet.jit.si

# Display name for the bot in meetings
JITSI_DISPLAY_NAME=AI Assistant

# Optional: JWT authentication for private Jitsi servers
# JITSI_JWT_APP_ID=your_app_id
# JITSI_JWT_SECRET=your_jwt_secret

# Recording settings
RECORDINGS_DIR=./recordings
RECORDING_FORMAT=webm

# Server settings
PORT=3000
HOST=0.0.0.0

# Anthropic API key (for AI-powered responses in chat)
# ANTHROPIC_API_KEY=your_api_key

# Browser settings
HEADLESS=true
# Set to false for debugging - will show browser window
